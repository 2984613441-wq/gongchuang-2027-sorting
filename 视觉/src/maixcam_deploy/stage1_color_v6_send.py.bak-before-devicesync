def _bump(gate, color=None):
    """拒绝计数统一入口：同时记全局与按色。全局键名不变，老读法继续有效。"""
    _REJ[gate] = _REJ.get(gate, 0) + 1
    if color is not None:
        _d = _REJ_C.setdefault(gate, {})
        _d[color] = _d.get(color, 0) + 1

