        # 报告自己和自己打架，看报告的人会被带偏。根因同 ⑤：重新推导而非取唯一真相。
        cx, cy = r.get("center") or (int(left + w / 2), int(top + hgt / 2))
        shown.append((cx, cy))
        print("   bin=%d color=%-7s bbox320=%s center=(%d,%d) color_fraction=%.4f"
              % (r["bin"], r["color"], str(r["bbox"]), cx, cy, r["color_fraction"]))
    payload = M.encode_batch_targets(results, M.TASK_ID)
    print("wire       : %d bytes (只编码，未发送)  %s"
          % (len(payload), payload.hex(" ").upper()))
    # 把 wire 解回来和上面显示的中心逐件对齐：报告内部自洽由这一行保证，
    # 不一致就当场喊 —— 不再靠人眼比对十六进制。
    # 格式权威 = 生产文件的 struct.pack(">BBHHB", bin_id, conf, cx, cy, angle) 那行，
    # 批头 = bytes([count]) + struct.pack(">H", task_id) ⇒ 3 字节。
    # ⚠️ 交接文档里写的"target_seq/class_id/image_id"是错的（字段名与个数都不对），
    #    以生产源码为准；本脚本刻意做一次独立解码，就是为了能抓出编码器被改坏。
    bad = []
    for i, off in enumerate(range(3, len(payload), 7)):
        wx = (payload[off + 2] << 8) | payload[off + 3]
        wy = (payload[off + 4] << 8) | payload[off + 5]
        if i < len(shown) and (wx, wy) != shown[i]:
            bad.append("#%d wire=(%d,%d) 显示=%s" % (i, wx, wy, shown[i]))
        print("   wire[%d] id=%d conf=%d x=%d y=%d angle=0x%02X"
              % (i, payload[off], payload[off + 1], wx, wy, payload[off + 6]))
    print("wire检查   : %s"
          % ("逐件与上面 center 一致" if not bad
             else "❌ 不一致 " + "; ".join(bad)))
    print("network    : socket 建立 0 次，向 8765 发送 0 字节")
    print(line)


def save_mask_montage(path, masks, order):
    panels = []
    sep = np.full((next(iter(masks.values())).shape[0], 3, 3), 64, np.uint8)
    for color in order:
        p = np.dstack([masks[color]] * 3)
        cv2.putText(p, color, (4, 16), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (0, 255, 0), 1)
        panels.append(p)
        panels.append(sep)
    cv2.imwrite(path, np.hstack(panels[:-1]))


def main(argv):
    global POSE, LIGHT, SEQ
    if len(argv) == 2 and argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    if len(argv) >= 4:
        POSE, LIGHT, SEQ = argv[1], argv[2], argv[3]

    M, src = load_production()
    from maix import camera, image

    tag = "%s_%s_%s" % (POSE, LIGHT, SEQ)
    os.makedirs(OUT_DIR, exist_ok=True)
    png = os.path.join(OUT_DIR, tag + ".png")
    png_mask = os.path.join(OUT_DIR, tag + "_mask.png")

    t0 = time.monotonic()
    cam = camera.Camera(REQ_FRAME_SIZE, REQ_FRAME_SIZE, image.Format.FMT_RGB888)
    try:
        for _ in range(WARMUP_FRAMES):
            cam.read()
        frame = None
        for _ in range(MAX_READ_RETRY):
            frame = cam.read()
            if frame is not None:
                break
        if frame is None:
            print("读不到帧：相机被别的进程占着？先把 V6 停掉。")
            return 2
        frame_wh = (frame.width(), frame.height())
        # 和生产完全同一口径：:370 共享视图 + :372 input_rgb=True
        rgb = image.image2cv(frame, ensure_bgr=False, copy=False)
        # ⑤ 只有一个 analyze()：这里不再有"副本 vs 生产"的比对，改成
        #    "按色重新打包后的闸计数 vs 生产函数自己的 _REJ" 的独立复算。
        results, report, masks, xcheck = analyze_via_production(
            rgb, M, input_rgb=True)
        try:
            frame.save(png)
        except Exception as exc:      # 极端情况下退回 cv2（颜色已 RGB->BGR）
            cv2.imwrite(png, cv2.cvtColor(rgb, cv2.COLOR_RGB2BGR))
            print("[warn] frame.save 失败(%s)，已退回 cv2.imwrite" % exc)
        save_mask_montage(png_mask, masks, list(M.COLOR_TO_MATERIAL))
        print_report(tag, src, frame_wh, report, results, M, png, png_mask,
                     xcheck, (time.monotonic() - t0) * 1000.0)
        del rgb
    finally:
        cam.close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
