# 树莓派端开机自启示例（真实链路）
#
# 安装：
#   sudo cp ec-chain.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ec-chain
# 查看日志：
#   journalctl -u ec-chain -f
#
# 说明：
#   * 所有路径均为占位，按实际拷贝位置修改 WorkingDirectory / Environment / ExecStart。
#   * systemd 没有现场交互终端，绝不能带 --start-round；真实 --start-round 现在要求
#     操作员输入 HOME。服务只启动链路并保持 RECOVERY_LOCK 待命。
#   * User=pi 需在 dialout 组（树莓派默认）才能访问串口 /dev/ttyAMA0。
#   * 波特率 BAUD=115200 为已冻结的 STM32 USART2 配置（8N1），一般无需修改。

[Unit]
Description=EC Chain: Raspberry Pi host-side closed loop (UART <-> STM32, HDMI display)
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/ec-chain/deploy
Environment=PYTHONPATH=/opt/ec-chain/src

# ---- 部署占位：按实际环境填写（与 run_chain.py 的环境变量同名）----
Environment=PORT=/dev/ttyAMA0
Environment=BAUD=115200
Environment=IMAGE_DIR=/opt/ec-chain/images
Environment=FONT=/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc
Environment=NAMES_FILE=/opt/ec-chain/names.json
Environment=ROUND_ID=round-1
Environment=ROUND_TASK_ID=7
Environment=FRAME_OUTPUT=fb0
# ----------------------------------------------------------------------

ExecStart=/opt/ec-chain/deploy/.venv/bin/python /opt/ec-chain/deploy/run_chain.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
