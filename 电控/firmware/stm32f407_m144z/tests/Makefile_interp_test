# Makefile for XY interpolation algorithm unit tests
# This compiles the pure-algorithm tests on the host (Linux/Windows/Mac)

CC = gcc
CFLAGS = -Wall -Wextra -std=c99 -I../App/Inc
TARGET = test_ec_interp

SRCS = test_ec_interp.c ../App/Src/ec_interp.c
OBJS = $(SRCS:.c=.o)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET) $(TARGET).exe

run: $(TARGET)
	./$(TARGET)

.PHONY: all clean run
