# ============================================================
# 相机标定配置文件 v1.0
# ============================================================
#
# 本文件定义 像素坐标 → 装置坐标(mm) 的换算参数
#
# 使用方法：
#   1. 执行九点标定（见 docs/plans-2026-09-16/W6-标定操作流程.md）
#   2. 计算仿射矩阵 6 个参数（用 numpy.linalg.lstsq 或手算）
#   3. 填入下面的 [CameraCalibration] 节
#   4. 运行 python 电控/src/electrical_control/rpi/pixel_to_device.py 自检
#   5. 九宫格反向验证（目标 RMS ≤ 2mm）
#
# ⚠️ 警告：
#   - 下面的参数都是 **占位值**，需实测后填入
#   - 未标定时所有像素→mm 转换返回 None（拒识所有物体）
#   - 标定错误会导致抓取偏移（送错盒 = 判负级错误）
#
# ============================================================

[CameraCalibration]
# 仿射变换矩阵参数（6 个）
# 公式：
#   x_mm = a11*u + a12*v + tx
#   y_mm = a21*u + a22*v + ty
# 其中 (u,v) 是像素坐标（bbox中心），(x,y) 是装置坐标（单位 mm）

# ⚠️ 下面都是占位值，需实测后替换
# —— 2026-09-18 粗标（机器未装配时用"物块推到托盘两端"实测得出）——
# 数据来源：树莓派只监听 MaixCAM（工具/pi_fov_probe.py），把件推到托盘两端：
#   X: 像素 57 ↔ -95.0mm ，像素 232 ↔ +95.0mm
#      → 比例 190mm/175px = 1.08571 mm/px，x=0 落在像素 144.5
#   Y: 像素 142 ↔ -97.5mm，像素 232 ↔ 0mm（托盘在 Y 负半轴）
#      → 比例 97.5mm/90px = 1.08333 mm/px，y=0 落在像素 232
# 两轴比例一致（1.086 vs 1.083）→ 镜无畸变、像素为方，可交叉验证。
#
# ⚠️ 精度约 ±5mm（手推到底的误差），够做演示，不够做精细抓取。
#    机器装回后须做正式九点标定替换本组值（工具/calib_photo.py 或 calib_grid.py）。
#
# 🔴 Y 的方向符号【未实测确认】：本组值假定"装置 +Y = 画面 v 增大方向"。
#    若机器首次运动时 Y 往反方向跑，把 a22 与 ty 同时取反即可：
#        a22 = -1.083333   ty = 251.333333
#    ⚠️ 反向会导致 Y 跑到另一侧半区（转盘侧），可能超程 —— 首测必须有人在旁边急停。
a11 = -0.027890   # 2026-09-19 两锚点实测:画面中心px158->+65.0mm, X最远px258->+120.0mm
a12 = -0.477932
tx = 145.697000   # 2026-09-19 两锚点实测
a21 = -0.477932
a22 = 0.027890   # 2026-09-19 见a11注释;与a11差0.4%符合方形像素
ty = 39.782000   # 2026-09-19 两锚点实测

# 相机高度（镜头到标定平面（托盘面）的垂直距离，单位 mm）
# 实测值：镜头离地 475mm，托盘面离地 213mm → d = 262mm
# 用于高度视差补偿公式：scale = d/(d-h)
camera_height = 262.0

# 标定日期（记录用，不影响计算）
calibration_date = 未标定

# 标定人员（记录用）
calibrated_by = 待填


[ObjectHeights]
# 物体高度（单位 mm）
# 索引：box_id（校赛模式，颜色唯一确定货物）
# box_id = height_mm
#
# ⚠️ 需实测：用游标卡尺量每类物体的高度
# 高度用于视差补偿：h 越大，视差越大
# 缺失或非法时拒识该件；只有显式配置 0 才表示无需高度补偿
# 转换函数保留历史参数名 class_id，但适配器传入的是 VisionTarget.box_id
#
# 校赛 6 种货物（2027 工创赛智能分拣）：
# 🔴 2026-09-18 粗标期间【全部置 0】，这是有意的，不是忘了填：
#   本次粗标是操作员把物块【底面】推到托盘两端、直接按底面位置反解出来的，
#   所以仿射矩阵 affine(像素) 给的**已经是底面坐标**。
#   若此时再套一步视差补偿（顶面→底面），等于把同一件事做两遍 → 多缩一次。
#   故粗标期间置 0 = 关掉视差补偿，抓取直接用仿射结果，正确。
#
# ⚠️ 机器装回后做正式九点标定（用夹爪/平面靶标）时，必须把下面 6 个真实高度填回来，
#    否则 40mm 高的件会因未补偿视差而偏约 14mm（camera_height=262mm 时）。
#    届时用游标卡尺实测：正方体、三棱柱、圆柱各自的底面到顶面高度。
#
# 🔴🔴 2026-09-22 实值已填（读上面那段"粗标期间全部置 0"之前先看这里）：
#    下面 6 个值**已经不是 0** —— 已按实测填入 40/40/32.5/32.5/30/30
#      （正方体 40；三棱柱 32.5（矩形朝向 35、三角朝向 30 取中值）；圆柱 30）。
#    上面那段"粗标期间全部置 0，这是有意的"**只对 2026-09-18 那次粗标成立**；
#    现口径 = 装回后重新标定 ⇒ **视差补偿必须是开的**。
#    实测依据（别再关掉）：关掉时同一件 PICK_y 掉到 -114.3（越界 16.8mm）；
#      开着时 -96.5 在区内，且用户目视"位置差不多" ✓。
#    ⚠️ 键是【数字 box_id 1..6】，不是 class_id、不是名字。
1 = 40.0  # 2026-09-22 实测件高（**不再是**粗标期的 0，见上）
2 = 40.0
3 = 32.5
4 = 32.5
5 = 30.0
6 = 30.0


[WorkspaceLimits]
# 工作区限制（单位 mm，原点=装置中心）
# 超出此范围的物体会被拒识（返回 None）

# X 轴范围（2026-09-18 二次修正：用户用尺手工推量，X 总行程 19.0cm = 190mm，
#            原点取行程中心 → ±95.0mm）
# 同步方见 ec_motion_plan.h 的 EC_MOTION_REACH_LIMIT_X_MM10 = 950
# 🔴 旧值 ±105.0mm 系记录错误（当时把 X/Y 记反了），已作废：
#    X 被多算 20mm，导致固件放行了 200mm 的移动命令而 X 实际只有 190mm，
#    超出部分脉冲打在硬限位上 → 丢步 + 坐标基准失准。
# 🔴 2026-09-21 修正：本节此前写的是【滑台行程】(±95 / ±97.5)，却被当作【装置坐标】在用。
#    正确值 = 夹爪够得着 ∩ 相机看得见：
#      滑台可达 x∈[-95.0,+85.0] y∈[-97.5,+87.5]  →  装置 = 滑台+(120.5,43.5)
#                                                  →  x∈[25.5,205.5] y∈[-54.0,131.0]
#      相机可见（155.4mm 视场，仿射四角算）        →  x∈[-5.7,163.5] y∈[-117.1,52.1]
#      ⇒ 交集 = x∈[25.5,163.5] y∈[-54.0,52.1]
#    ⚠️ 但 pixel_to_device 的校验器把协议上限 ±145.0 套在了【装置坐标】限制上，
#       163.5 会被判「超出协议可序列化范围」⇒ 整份标定作废、全部拒识。
#       故这里先写 145.0（损失 device x∈(145,163.5] ≙ 滑台 x∈(24.5,43]，可接受）。
#       要拿回这 18.5mm 需改校验器或重新对齐坐标系原点，属另一件事。
#    后果（修正前实测）：圆柱 at 装置(97.46,-40.19) = 滑台(-23.0,-83.7)（**够得着**）
#    被 x_max=95 白拒 ⇒ 现场表现为「看得见却抓不到」。
# 🔴🔴 2026-09-21 二次修正（重要，别再改错）：
#    本节的坐标系 = **最终下发的 PICK（滑台记账坐标）**，不是装置坐标！
#    依据 pixel_to_device.py:478-505：pixel_to_device 刻意用 check_workspace=False 跳过
#    装置坐标检查，叠加 ToolOffset【之后】才用本节的值校验 —— 即本节比的是滑台坐标。
#    ⇒ 取「夹爪实际可达的滑台范围」：x∈[-95.0, +85.0]（距原点 18.0cm）、
#      y∈[-97.5, +87.5]（距原点 18.5cm）。
#    ⚠️ 曾一度被误改成装置坐标口径 [25.5,145.0]x[-54.0,52.1]（那是相机∩可达的交集），
#       结果滑台坐标全都过不了 ⇒ **整条链把所有件都拒掉**（2026-09-21 实测：
#       PICK=(-59.0,-54.2) 被判越界）。已改回。
#    ⚠️ 已知隐患（未修）：pixel_to_device(check_workspace=True) 那条路把同一组值
#       当【装置坐标】用 ⇒ 两处坐标系不一致。**链上不走那条**（它传 False），
#       但自己写脚本调 pixel_to_device() 时不要用默认值。
x_min = -95.0
x_max = 85.0

# Y 轴范围（2026-09-18 四次修正：机械组修复了 Y 末端阻挡，可达行程 +约15mm；
#            仍保留约 1.5cm 不可达 → 当前可达约 195mm，原点取行程中心 → ±97.5mm）
# 同步方见 ec_motion_plan.h 的 EC_MOTION_REACH_LIMIT_Y_MM10 = 975
# 🔴 取保守侧：宁可少用 5mm，不可超程（超程会堵转并带挂主控）。
# 🔴 机械再次调整后必须重新实测再改。
y_min = -97.5
y_max = 87.5

# ============================================================
# 标定质量指标（记录用，不影响计算）
# ============================================================
#
# [CalibrationQuality]
# # 九宫格验证 RMS 误差（单位 mm）
# rms_error = 未验证
#
# # 单点最大误差（单位 mm）
# max_error = 未验证
#
# # 标定点数量
# calibration_points = 0
#
# ============================================================

[ToolOffset]
# 夹爪中心相对滑台坐标点的偏移补偿。整链发的目标 = 像素→装置坐标 + 本节。
# 实测：夹爪偏 (+120.5, +43.5)mm（夹爪在正方向一侧），故这里写负值，
# 使滑台实际走到「物块 − (120.5, 43.5)」。
# 2026-09-19 五样本实测：(115,47)/(128,42)/(118.5,41.5)/(120.5,43.5)/(120.5,43.5)
# 依据：工具/pi_bench_goto.py 逐次逼近，每次由用户目视确认夹爪正中物块。
# 🔴🔴 2026-09-22 实值已改：读下面那段之前先看这里，否则会被它诱导改回去 ——
#    现值 = **x_mm = -108.5 / y_mm = -29.5**（**不是**下面写的 -20.5）。
#    为什么改：用户当场裁决「**标定当时人工把 Y 向 +1cm 干涉过**」⇒ Y 向回退约 -1cm。
#      先试过 -30.5：会把件推出【工作区下限】约 1mm；-29.5 让件回到区内，余量约 0.4mm。
#    ⚠️ 所以下面那段原裁决里这两句**数值已过期**且**这次是有据的例外**：
#         「本值 = 标定真值 (-108.5, -20.5)」「不得再加任何"向外偏"」
#       它**仍然有效**的部分：不要为了"让夹爪往外一点"而随手改本值 ——
#       本节与 3 点标定是**同一条闭环**，改它 = 把整条映射推偏，不是"调一个旋钮"。
#       若确实要让夹爪相对件外偏，应另加一个只为夹取用的偏置（新字段/新节）。
#
# 🔴 2026-09-22 原裁决（**数值已过期**，保留以免重走）：本值 = **标定真值 (-108.5, -20.5)**，
#    **不得再加任何"向外偏"**。历史上有过两次人为外偏，均已作废：
#      y_mm = -10.5（= 向外 +1cm）、y_mm = -15.5（= 向外 +0.5cm）
#    ⇒ 加外偏会让**每个取料点整体偏移**（实测：偏 +10mm 时夹爪停在件旁边合嘴、**夹空**）。
#    ⚠️ 本节与 3 点标定是**同一条闭环**：标定解出装置坐标时用的就是 (-108.5, -20.5)，
#       所以改本值 = 把整条映射推偏，不是"调一个偏移旋钮"。
#       若确实要让夹爪相对件外偏，应**另加一个只为夹取用的偏置**（新字段/新节），不要动本值。
#    ⚠️ 另有一份独立的 [ToolOffset] 在 deploy/pick_strategy.ini（被 chain_adapter 用于反向换算），
#       那份与本节不是同一来源，**统一口径的处置另议**，不要照它改本值。
x_mm = -108.5
y_mm = -20.5
# 🔴🔴 2026-09-22 第五次修正（y_mm：-29.5 → **-20.5**）= **撤回**同日晚些时候那次"Y 向 −1cm"改动
#    依据（用户现场目视，用台架命令把滑台停在取料点、夹爪抬起张开，直接看夹爪是否正中）：
#      在橙圆柱的取料点 (滑台 -32.7,-33.5) 处，夹爪合嘴中心**偏 −Y 约 1cm**
#      ⇒ 要让目标 Y 增 10mm ⇒ y_mm 加 10 ⇒ -29.5 + 10 = **-19.5**（与标定真值 -20.5 差 1mm）
#    ⇒ 取 **-20.5**（回到标定闭环解出的原值）而不取 -19.5：
#      ① 它才是标定本身给的值；②用户实测落在它 1mm 内（肉眼估读分辨率之内）；
#      ③ 那次 -9mm 改动的前提"标定当时人工把 Y 向 +1cm 干涉过"已随**摄像头复原**而消失。
#    🔴 **关键观察**：今晚 Y 的两次改动 −20.5→−29.5（−9mm）与本次 +10mm **几乎正好相反**
#      ⇒ 强烈提示那次 −9mm 也是在**补偿摄像头位移**，而不是真实标定偏置。
#    ⚠️ 仍未证伪的前提：**摄像头是否真的复原到标定时的位置**。
#      若不是，误差会**随视场位置变化**（不是常数偏置）⇒ 改完必须**换一件/换个位置**再验一次。
#    ⚠️ 本节只作用于 PICK；落点 [DropPoints] 已是滑台记账坐标、不再叠加本节。
# 🔴🔴 2026-09-22 第四次修正（x_mm：-111.5 → **-108.5**）= **撤回**同日早些时候那次"3mm 补偿**
#    撤回依据（用户 2026-09-22 现场查明根因）：当时观测到的"夹爪合嘴中心偏 +X 约 0.3cm"，
#      是因为**摄像头被碰动了一点**，不是标定或偏置本身有问题；用户随后**已把摄像头复原**。
#      ⇒ 观测前提消失 ⇒ 补偿必须撤回。否则等于把"摄像头位移"永久焙进配置 ——
#        下次摄像头再动，误差会**叠加**而不是被纠正。
#    ⚠️ y_mm = -29.5 **保持不动**：它是另一件事（用户口径"标定当时人工把 Y 向 +1cm 干涉过"），
#       与摄像头位移无关，不要跟着一起改回。
#    ⚠️ 历史留档（别再重复）：同日我曾把 x_mm 改成 -111.5，并写下"3mm 系统性偏差值得修"。
#       那是**从观测倒推**、没先问"为什么会偏"。教训：
#       **动标定/偏置之前，先确认测量前提没变**（相机位置、托盘位置、件高）。
#    ⚠️ 若改回 -108.5 后夹取又偏：**先查相机是否松动/被碰**、用已知位置的物块复核，
#       不要重新往配置里加补偿。
#    ⚠️ 本节**只作用于 PICK**（落点 [DropPoints] 已是滑台记账坐标、不再叠加本节）
#       ⇒ 改它不会动落点、也不会动标定矩阵。
